# =============================================================================
# Frontend Next.js (BFF OAuth 2.0) — contoh konfigurasi (salin ke .env.local)
# Semua variabel di bawah HANYA dibaca di server (Route Handler / proxy.ts).
# JANGAN pakai prefiks NEXT_PUBLIC_ untuk nilai rahasia.
# =============================================================================

# URL publik aplikasi (dipakai untuk redirect_uri & validasi Origin/CSRF)
APP_BASE_URL=http://localhost:3000

# Base URL API Django (server-to-server dari BFF; browser tidak memanggil langsung)
API_BASE_URL=http://127.0.0.1:8001/api

# OpenID Connect (Keycloak realm dhana-putra)
OIDC_ISSUER=http://localhost:8080/realms/dhana-putra
OIDC_CLIENT_ID=dhana-putra-web
# Secret client confidential dari Keycloak (Clients > dhana-putra-web > Credentials).
# Kosongkan bila client dikonfigurasi sebagai public client (PKCE tetap wajib).
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_API_AUDIENCE=dhana-putra-api
OIDC_ROLE_CLAIM_PATHS=resource_access.dhana-putra-api.roles

# Kunci enkripsi cookie sesi (min. 32 karakter acak):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cookie Secure: default otomatis true bila APP_BASE_URL https://. Production wajib true.
# SESSION_COOKIE_SECURE=false
